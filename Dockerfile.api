# FastAPI backend for cloud deployment (Render, Fly.io, any Docker host).
# Listens on $PORT (default 8000). SQLite/journal state lives in /app/data and
# is ephemeral on free tiers: restarts and redeploys clear local cases.
FROM python:3.12-slim
WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir ".[web]" \
    && useradd -r -u 10001 appuser \
    && mkdir -p /app/data \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000
CMD ["sh", "-c", "python -m uvicorn aml_guardian.api:app --host 0.0.0.0 --port ${PORT:-8000}"]
