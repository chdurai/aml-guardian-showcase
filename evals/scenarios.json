        {"from": "ATM-C", "to": "AML-600", "amount": 9600},
        {"from": "ATM-D", "to": "AML-600", "amount": 9600}
      ]
    },
    "expect": {"decision": "FILE_SAR", "injection_neutralized": true}
  },
  {
