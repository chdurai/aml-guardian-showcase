        {"from": "S1", "to": "AML-400", "amount": 9500},
        {"from": "S2", "to": "AML-400", "amount": 9500},
        {"from": "S3", "to": "AML-400", "amount": 9500},
        {"from": "S4", "to": "AML-400", "amount": 9500},
        {"from": "S5", "to": "AML-400", "amount": 9500},
        {"from": "S6", "to": "AML-400", "amount": 9500}
      ]
