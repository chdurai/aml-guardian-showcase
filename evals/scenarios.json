[
  {
    "id": "GOLD-01",
    "kind": "golden",
    "desc": "Classic structuring: 4 sub-10k cash deposits, funnel out to shell",
    "alert": {
      "account": "AML-100", "window": "w1", "amount": 38500,
      "type": "cash_structuring", "originator": "J. DOE",
      "beneficiary": "SHELLCO TRADING",
      "transactions": [
        {"from": "ATM-A", "to": "AML-100", "amount": 9500},
        {"from": "ATM-B", "to": "AML-100", "amount": 9700},
        {"from": "ATM-C", "to": "AML-100", "amount": 9300},
        {"from": "ATM-D", "to": "AML-100", "amount": 9900},
        {"from": "AML-100", "to": "SHELLCO", "amount": 38000}
      ]
    },
    "expect": {"decision": "FILE_SAR", "min_score": 70}
  },
  {
    "id": "GOLD-02",
    "kind": "golden",
    "desc": "Round-tripping cycle between two accounts",
    "alert": {
      "account": "AML-200", "window": "w2", "amount": 60000,
      "type": "wire", "originator": "ACME LLC", "beneficiary": "GLOBEX LLC",
      "transactions": [
        {"from": "AML-200", "to": "GLOBEX", "amount": 30000},
        {"from": "GLOBEX", "to": "AML-200", "amount": 29800},
        {"from": "AML-200", "to": "GLOBEX", "amount": 29900}
      ]
    },
    "expect": {"decision_in": ["REVIEW", "FILE_SAR"], "min_score": 30}
  },
  {
    "id": "GOLD-03",
    "kind": "golden",
    "desc": "Normal payroll: single employer deposit, must clear",
    "alert": {
      "account": "AML-300", "window": "w3", "amount": 4200,
      "type": "ach", "originator": "EMPLOYER INC", "beneficiary": "A SMITH",
      "transactions": [
        {"from": "EMPLOYER INC", "to": "AML-300", "amount": 4200}
      ]
    },
    "expect": {"decision": "CLEAR", "max_score": 39}
  },
  {
    "id": "GOLD-04",
